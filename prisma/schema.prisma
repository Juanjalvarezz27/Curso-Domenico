generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  BASICO
  PREMIUM
}

model User {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  password  String   
  role      Role     @default(USER)
  plan      Plan     @default(BASICO)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}